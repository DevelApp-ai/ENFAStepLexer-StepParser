<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)' != 'Release'">false</GeneratePackageOnBuild>
    
    <!-- Suppress ICU4N SDK version warnings since we're constrained to .NET 8.0 -->
    <NoWarn>ICU4N_IDE_0001;NU5104</NoWarn>
    
    <!-- Package Information -->
    <PackageId>DevelApp.StepParser</PackageId>
    <Version>1.2.0</Version>
    <Title>Step Parser - GLR-Style Multi-Path Parsing with CognitiveGraph Integration</Title>
    <Description>A modern parser implementation with GLR-style multi-path parsing, context-sensitive grammar support, and CognitiveGraph integration for advanced semantic analysis. Part of the GrammarForge step-parser architecture.</Description>
    <Authors>DevelApp</Authors>
    <Company>DevelApp</Company>
    <Product>DevelApp.StepParser</Product>
    <Copyright>Copyright (c) 2024 DevelApp</Copyright>
    
    <!-- Package Metadata -->
    <PackageTags>parser;glr;multi-path;context-sensitive;grammar;cognitive-graph;step-parser</PackageTags>
    <PackageProjectUrl>https://github.com/DevelApp-ai/ENFAStepLexer-StepParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DevelApp-ai/ENFAStepLexer-StepParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Release Notes -->
    <PackageReleaseNotes>
      v1.2.0: 
      - UPDATED: CognitiveGraph dependency to 1.1.0 with V2 schema support for massive graphs
      - NEW: Support for both V1 and V2 CognitiveGraph schemas
      - NEW: Configurabl
e sche
ma version in StepParserEngine constructor
      - ENHANCED: Backward compatibility maintained with V1 schema as default
      - ENHANCED: Extended test coverage for V2 schema integration
      
      v1.0.1: 
      - NEW: StepParser with GLR-style multi-path parsing for ambiguity resolution
      - NEW: Context-sensitive grammar support with hierarchical scopes
      - NEW: CognitiveGraph integration for advanced semantic analysis
      - NEW: Grammar inheritance with ANTLR/Bison/Yacc base grammar support
      - NEW: Location-based refactoring operations (extract, inline, rename)
      - ENHANCED: Projection match triggered semantic rules
    </PackageReleaseNotes>
    
    <!-- Documentation -->
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevelApp.StepLexer\DevelApp.StepLexer.csproj" />
    <PackageReference Include="DevelApp.CognitiveGraph" Version="1.1.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
